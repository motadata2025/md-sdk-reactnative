{
    "name": "@motadata365/mobile-react-native",
    "version": "1.0.0",
    "description": "A client-side React Native module to interact with Motadata",
    "keywords": [
        "motadata",
        "rum",
        "react-native",
        "android"
    ],
    "author": "Motadata",
    "homepage": "https://github.com/motadata2025/md-sdk-reactnative#readme",
    "repository": "https://github.com/motadata2025/md-sdk-reactnative",
    "bugs": {
        "url": "https://github.com/motadata2025/md-sdk-reactnative/issues"
    },
    "license": "Apache-2.0",
    "main": "lib/commonjs/index",
    "files": [
        "src/**",
        "!src/**/__tests__/**",
        "!src/**/__mocks__/**",
        "!src/**/__snapshots__/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.test.js",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "lib/**",
        "scripts/**",
        "android/build.gradle",
        "android/detekt.yml",
        "android/gradle.properties",
        "android/src/main/**",
        "jest",
        "motadata-sourcemaps.gradle",
        "motadata-configuration.gradle",
        "motadata-configuration.schema.json"
    ],
    "types": "lib/typescript/index.d.ts",
    "react-native": "src/index",
    "source": "src",
    "module": "lib/module/index",
    "exports": {
        ".": {
            "import": "./lib/module/index.js",
            "require": "./lib/commonjs/index.js",
            "types": "./lib/typescript/index.d.ts"
        },
        "./metro": {
            "import": "./lib/module/metro.js",
            "require": "./lib/commonjs/metro.js",
            "types": "./lib/typescript/metro.d.ts"
        },
        "./jest": {
            "import": "./jest/mock.js",
            "require": "./jest/mock.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "jest",
        "lint": "eslint .",
        "prepare": "rm -rf lib && yarn bob build",
        "postinstall": "node scripts/replace-react-require.js"
    },
    "peerDependencies": {
        "react": ">=16.13.1",
        "react-native": ">=0.63.4 <1.0"
    },
    "devDependencies": {
        "@testing-library/react-native": "7.0.2",
        "react-native-builder-bob": "0.26.0"
    },
    "jest": {
        "preset": "react-native",
        "moduleNameMapper": {
            "@motadata365/mobile-react-native": "<rootDir>../core/src",
            "@motadata365/mobile-react-native/metro": "<rootDir>../core/src/metro"
        },
        "modulePathIgnorePatterns": [
            "<rootDir>/lib/"
        ],
        "testPathIgnorePatterns": [
            "/__utils__/",
            "/__fixtures__/"
        ],
        "setupFiles": [
            "./../../jest.setup.js"
        ],
        "transformIgnorePatterns": [
            "jest-runner"
        ]
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "tsc": "./../../node_modules/.bin/tsc"
                }
            ]
        ]
    },
    "codegenConfig": {
        "name": "MdSdkReactNative",
        "type": "modules",
        "jsSrcsDir": "./src/specs",
        "android": {
            "javaPackageName": "com.motadata.reactnative"
        }
    },
    "dependencies": {
        "big-integer": "^1.6.52"
    }
}
